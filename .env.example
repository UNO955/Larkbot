# 飞书应用凭证（开发者后台 → 应用凭证）
LARK_APP_ID=cli_xxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxx

# 白名单：只响应这个 open_id 发的消息（你本人）
OWNER_OPEN_ID=ou_xxxxxxxxxxxxxxxx

# 额外允许直接提问 / 操作卡片的用户 open_id，支持逗号、分号、空格或换行分隔
ALLOWED_OPEN_IDS=

# 首次启动时写入 bots.json 的默认机器人名称
BOT_NAME=larkbot-dev

# traex 在开发机上的执行工作目录
TRAEX_CWD=/Users/you/your-project

# traex 可执行文件路径（登录 shell PATH 不含 ~/.local/bin 时必填）
# 远程开发机常见：/home/you/.local/bin/traex
TRAEX_BIN=traex

# traex 会话仓库。建议给 larkbot 单独配置，避免和手动 traex 共用 ~/.trae。
TRAE_HOME=/Users/you/.larkbot/trae

# 可选：指定新建 traex 会话的模型；留空使用 CLI 默认模型
TRAEX_MODEL=

# 可选：设为 1 时不注入目录 trust / bypass 参数，适合手动调试严格模式
TRAEX_SANDBOX=0

# 控制台监听地址和端口。需要让飞书卡片里的“打开思考过程”给其他人可访问时，
# CONSOLE_HOST 不能是 127.0.0.1，CONSOLE_PUBLIC_URL 必须是内网可访问地址。
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8787
CONSOLE_PUBLIC_URL=http://127.0.0.1:8787

# 本地状态文件目录。建议不要放在仓库内；如必须放仓库内，.gitignore 已忽略 .larkbot/。
LARKBOT_STATE_DIR=/Users/you/.larkbot

# Argos 跳转 URL 模板。最终回复里识别到 logid/log_id 时，会用该模板生成底栏跳转按钮；识别到 PSM 时填充 {psm}。
ARGOS_URL_TEMPLATE=https://cloud.bytedance.net/argos/streamlog/info_overview/log_id_search?data_source_uid=&logId={logid}&log_search=false&psm={psm}&psmList=&region=China-North&x-bc-region-id=bytedance&x-resource-account=public

# 会话生命周期：活跃会话闲置多久后自动关闭；关闭记录保留多久后删除。设为 0 可关闭对应自动机制。
SESSION_IDLE_CLOSE_HOURS=72
SESSION_CLOSED_RETENTION_DAYS=7

# 调试飞书 SDK 时打开更详细日志；生产运行建议留空
DEBUG=
