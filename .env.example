# 飞书应用凭证（开发者后台 → 应用凭证）
LARK_APP_ID=cli_xxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxx

# 白名单：只响应这个 open_id 发的消息（你本人）
OWNER_OPEN_ID=ou_xxxxxxxxxxxxxxxx

# traex 在开发机上的执行工作目录
TRAEX_CWD=/Users/you/your-project

# traex 可执行文件路径（登录 shell PATH 不含 ~/.local/bin 时必填）
# 远程开发机常见：/home/you/.local/share/traex/current/traex
TRAEX_BIN=traex

# traex 会话仓库。建议给 larkbot 单独配置，避免和 botmux/手动 traex 共用 ~/.trae。
TRAE_HOME=/Users/you/.larkbot/trae

# 控制台监听地址和端口。需要让飞书卡片里的“打开思考过程”给其他人可访问时，
# CONSOLE_HOST 不能是 127.0.0.1，CONSOLE_PUBLIC_URL 必须是内网可访问地址。
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8787
CONSOLE_PUBLIC_URL=http://127.0.0.1:8787

# Argos 跳转 URL 模板。最终回复里识别到 logid/log_id 时，会用该模板生成底栏跳转按钮。
ARGOS_URL_TEMPLATE=https://cloud.bytedance.net/argos/trace?log_id={logid}

# 会话生命周期：活跃会话闲置多久后自动关闭；关闭记录保留多久后删除；清理扫描间隔。
# 设为 0 可关闭对应自动机制。
SESSION_IDLE_CLOSE_HOURS=24
SESSION_CLOSED_RETENTION_DAYS=7
SESSION_CLEANUP_INTERVAL_MINUTES=10
